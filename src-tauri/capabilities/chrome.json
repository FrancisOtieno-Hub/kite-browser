{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "chrome",
  "description": "IPC access for Kite's own trusted chrome UI (tab bar, toolbar, library panel). Scoped by webview label rather than window label - content tabs share window 'main' but load arbitrary external sites, so they intentionally get no capability at all and no access to any Tauri command. The allow-* entries below are Tauri's auto-generated permissions for our own application commands (it converts underscores to hyphens automatically, e.g. get_bookmarks -> allow-get-bookmarks) - each command is additionally guarded directly in main.rs via require_chrome() as defense in depth.",
  "webviews": ["chrome"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "global-shortcut:default",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-new-tab",
    "allow-switch-tab",
    "allow-close-tab",
    "allow-reopen-closed-tab",
    "allow-activate-tab-at",
    "allow-cycle-active-tab",
    "allow-get-tabs",
    "allow-go-home",
    "allow-get-history",
    "allow-clear-history",
    "allow-remove-history-entry",
    "allow-get-bookmarks",
    "allow-get-downloads",
    "allow-open-download",
    "allow-show-download-in-folder",
    "allow-clear-downloads",
    "allow-remove-download-entry",
    "allow-add-bookmark",
    "allow-remove-bookmark",
    "allow-get-settings",
    "allow-get-blocklist-status",
    "allow-set-search-engine",
    "allow-set-homepage",
    "allow-set-content-blocking",
    "allow-toggle-site-allowlist",
    "allow-refresh-blocklist",
    "allow-choose-downloads-dir",
    "allow-show-library",
    "allow-hide-library",
    "allow-toggle-find-in-page",
    "allow-zoom-in",
    "allow-zoom-out",
    "allow-zoom-reset",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-save-login",
    "allow-vault-dismiss-login",
    "allow-vault-list-logins",
    "allow-vault-reveal-login",
    "allow-vault-copy-login-password",
    "allow-vault-delete-login",
    "allow-vault-unlock-and-save-login",
    "allow-vault-autofill",
    "allow-list-extensions",
    "allow-set-extension-enabled",
    "allow-reload-extensions",
    "allow-open-extensions-folder"
  ]
}
